    r.add_argument("--run")
    r.set_defaults(fn=cmd_record)

    r = sub.add_parser("verify", help="mark findings or artifacts verified, refuted or unverifiable")
    r.add_argument("ids", nargs="+", metavar="ID", help="finding ids (t_…#f1) or artifact ids")
    r.add_argument("--state", required=True, choices=VERIFY_STATES)
    r.add_argument("--note")
    r.add_argument("--by", help="who checked (default: host engine)")
    r.set_defaults(fn=cmd_verify)

    routing = sub.add_parser("routing", help="calibrate model routing from ledger data").add_subparsers(dest="sub", required=True)
    r = routing.add_parser("report", help="per role/engine/model/effort statistics")
    r.add_argument("--store", action="append", metavar="PATH", help="project (or .axp) to include; repeatable")
    r.add_argument("--role")
    r.add_argument("--json", action="store_true")
    r.set_defaults(fn=cmd_routing_report)
    r = routing.add_parser("suggest", help="recommend role defaults from the data")
    r.add_argument("--store", action="append", metavar="PATH")
    r.add_argument("--min-tasks", type=int, default=3, help="ignore models with fewer finished tasks")
    r.add_argument("--min-judged", type=int, default=5, help="judged findings needed before precision counts")
    r.add_argument("--apply", action="store_true", help="write suggested changes into roles/*.md")
    r.add_argument("--json", action="store_true")
    r.set_defaults(fn=cmd_routing_suggest)

    r = sub.add_parser("install", help="install the skills and agents into Claude Code and Codex for this checkout")
    r.add_argument("--claude-dir", default="~/.claude")
    r.add_argument("--codex-dir", default="~/.codex")
    r.add_argument("--codex-rules", action="store_true", help="also add the Codex rules that let Codex call Claude")
    r.add_argument("--uninstall", action="store_true")
    r.set_defaults(fn=cmd_install)

    sub.add_parser("roles", help="list roles from roles/*.md").set_defaults(fn=cmd_roles)
    r = sub.add_parser("sync-roles", help="generate Claude agents and Codex agent roles from roles/*.md")
    r.add_argument("--claude-dir", default="~/.claude/agents")
    r.add_argument("--codex-dir", default="~/.codex/agents")
    r.add_argument("--check", action="store_true", help="show pending changes; exit 1 if any")
    r.set_defaults(fn=cmd_sync_roles)

    r = sub.add_parser("status")
    r.add_argument("--run")
    r.add_argument("--json", action="store_true")
    r.set_defaults(fn=cmd_status)
    r = sub.add_parser("show", help="show an artifact, task, run or finding")
    r.add_argument("id")
    r.set_defaults(fn=cmd_show)
    r = sub.add_parser("search", help="search the index")
    r.add_argument("text")
    r.add_argument("--kind")
    r.add_argument("--run")
    r.set_defaults(fn=cmd_search)
    r = sub.add_parser("doctor", help="check CLIs, flags, schema and store")
    r.add_argument("--smoke", action="store_true", help="also run a live schema test on both engines")
    r.set_defaults(fn=cmd_doctor)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args) or 0
    except AxpError as e:
        print(f"axp: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
